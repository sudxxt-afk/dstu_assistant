# === Telegram ===
# Токен бота из @BotFather
BOT_TOKEN=123456:your-token-here
# Числовой Telegram ID владельца (единственный разрешённый пользователь).
# Оставь пустым при первом запуске — бот подскажет твой ID в ответ на сообщение.
ALLOWED_USER_ID=

# === API ===
# Секрет для доступа к REST API (заголовок X-API-Token). Придумай длинную строку.
API_TOKEN=change-me-to-a-long-random-string

# === Прочее ===
TZ=Europe/Moscow
# Пути внутри контейнера (менять не нужно — это тома Docker)
DATABASE_URL=sqlite+aiosqlite:////data/app.db
VAULT_PATH=/data/vault
